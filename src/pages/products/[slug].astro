---
import {
	decodeSlug,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);

if (!product) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function getImageUrl(imageValue: unknown): string | undefined {
	if (!imageValue || typeof imageValue !== "object") return undefined;
	const image = imageValue as Record<string, unknown>;

	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}

	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);

	return storageKey
		? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`
		: undefined;
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(product, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: getImageUrl(product.data.featured_image),
});

const categories = product.data.terms?.product_category ?? [];
const gallery = product.data.gallery_images ?? [];
const quoteUrl = `/pages/contact?product=${encodeURIComponent(product.data.title)}`;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	modifiedTime={product.data.updatedAt.toISOString()}
	content={{ collection: "products", id: product.data.id, slug }}
>
	<article class="product-page">
		<a href="/products" class="back-link">← Quay lại danh sách sản phẩm</a>

		<section class="product-overview" aria-labelledby="product-title">
			{
				product.data.featured_image ? (
					<div class="product-media" {...product.edit.featured_image}>
						<Image image={product.data.featured_image} />
					</div>
				) : (
					<div class="product-media product-media--empty" aria-hidden="true" />
				)
			}

			<div class="product-summary">
				<p class="product-eyebrow">Sản phẩm</p>
				<h1 id="product-title" class="product-title" {...product.edit.title}>
					{product.data.title}
				</h1>

				<div class="product-facts">
					<p>
						<strong>Xuất xứ:</strong>
						<span {...product.edit.origin}>{product.data.origin}</span>
					</p>
					<p>
						<strong>Tình trạng:</strong>
						<span class="availability" {...product.edit.availability}>
							{product.data.availability}
						</span>
					</p>
					{categories.length > 0 && (
						<p>
							<strong>Danh mục:</strong>
							<span>{categories.map((category) => category.label).join(", ")}</span>
						</p>
					)}
				</div>

				{product.data.sizes.length > 0 && (
					<div class="size-group" {...product.edit.sizes}>
						<span class="size-label">Kích thước</span>
						<div class="size-options">
							{product.data.sizes.map((size) => (
								<span class="size-option">{size}</span>
							))}
						</div>
					</div>
				)}

				<a
					href={quoteUrl}
					class="quote-button"
					aria-label={`Nhận báo giá cho ${product.data.title}`}
				>
					Nhận báo giá
				</a>
			</div>
		</section>

		{
			product.data.description && (
				<section class="product-description" {...product.edit.description}>
					<PortableText value={product.data.description} />
				</section>
			)
		}

		{
			gallery.length > 0 && (
				<section
					class="product-gallery"
					aria-labelledby="gallery-title"
					{...product.edit.gallery_images}
				>
					<h2 id="gallery-title">Thư viện hình ảnh</h2>
					<div class="gallery-grid">
						{gallery.map((item, index) => (
							<figure class="gallery-item">
								<Image image={item.h_nh_nh} />
								<figcaption>
									Hình ảnh {index + 1} — {product.data.title}
								</figcaption>
							</figure>
						))}
					</div>
				</section>
			)
		}
	</article>
</Base>

<style>
	.product-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-4) var(--spacing-6) var(--spacing-16);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--spacing-8);
		font-size: var(--font-size-sm);
		color: var(--color-brand);
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--color-brand-hover);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.product-overview {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(var(--spacing-8), 6vw, var(--spacing-16));
		align-items: center;
		padding-bottom: var(--spacing-12);
	}

	.product-media {
		display: grid;
		min-height: 460px;
		place-items: center;
		padding: var(--spacing-1);
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
	}

	.product-media img {
		width: 100%;
		height: 100%;
		max-height: 450px;
		object-fit: contain;
	}

	.product-media--empty {
		background: var(--color-surface);
	}

	.product-summary {
		align-self: start;
		padding-top: var(--spacing-4);
	}

	.product-eyebrow {
		margin-bottom: var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
	}

	.product-title {
		margin-bottom: var(--spacing-6);
		font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.product-facts {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-8);
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
	}

	.product-facts p {
		display: flex;
		gap: var(--spacing-1);
		flex-wrap: wrap;
	}

	.product-facts strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.availability {
		color: var(--color-brand);
		font-weight: 500;
	}

	.size-group {
		margin-bottom: var(--spacing-6);
	}

	.size-label {
		display: block;
		margin-bottom: var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-text);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.size-options {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.size-option {
		display: inline-flex;
		min-height: 38px;
		align-items: center;
		justify-content: center;
		padding: var(--spacing-2) var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
	}

	.quote-button {
		display: inline-flex;
		min-height: 42px;
		align-items: center;
		justify-content: center;
		padding: var(--spacing-2) var(--spacing-5);
		border-radius: var(--radius);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			background var(--transition-fast),
			transform var(--transition-fast);
	}

	.quote-button:hover {
		background: var(--color-brand-hover);
		transform: translateY(-1px);
	}

	.product-description {
		padding-top: var(--spacing-10);
		border-top: 1px solid var(--color-border);
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
	}

	.product-description :global(p) {
		margin-bottom: 1.5em;
	}

	.product-description :global(h2) {
		margin-top: 2.25em;
		margin-bottom: 0.65em;
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		color: var(--color-brand);
		letter-spacing: var(--tracking-snug);
	}

	.product-description :global(h2:first-child) {
		margin-top: 0;
	}

	.product-description :global(h3) {
		margin-top: 1.75em;
		margin-bottom: 0.5em;
		font-size: var(--font-size-xl);
	}

	.product-description :global(ul),
	.product-description :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.product-description :global(li) {
		margin-bottom: 0.5em;
	}

	.product-description :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-4) var(--spacing-6);
		border-left: 3px solid var(--color-brand);
		border-radius: 0 var(--radius) var(--radius) 0;
		background: var(--color-bg-subtle);
		color: var(--color-text-secondary);
	}

	.product-description :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.product-gallery {
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-10);
		border-top: 1px solid var(--color-border);
	}

	.product-gallery h2 {
		margin-bottom: var(--spacing-6);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		color: var(--color-brand);
		letter-spacing: var(--tracking-snug);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-4);
	}

	.gallery-item {
		overflow: hidden;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.gallery-item img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: contain;
	}

	.gallery-item figcaption {
		padding: var(--spacing-2) var(--spacing-3);
		border-top: 1px solid var(--color-border-subtle);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.product-page {
			padding: var(--spacing-4) var(--spacing-4) var(--spacing-12);
		}

		.product-overview {
			gap: var(--spacing-8);
		}

		.product-media {
			min-height: 360px;
		}

		.gallery-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 700px) {
		.back-link {
			margin-bottom: var(--spacing-5);
		}

		.product-overview {
			grid-template-columns: 1fr;
			padding-bottom: var(--spacing-10);
		}

		.product-media {
			min-height: 0;
			aspect-ratio: 1;
		}

		.product-summary {
			padding-top: 0;
		}

		.product-description {
			padding-top: var(--spacing-8);
		}
	}

	@media (max-width: 480px) {
		.product-title {
			font-size: var(--font-size-3xl);
		}

		.gallery-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
