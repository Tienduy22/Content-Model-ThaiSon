---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	description?: string;
	featuredImage?: MediaValue | string;
	href: string;
	origin: string;
	availability: string;
	sizes?: string[];
	categories?: Array<{ slug: string; label: string }>;
}

const {
	title,
	description,
	featuredImage,
	href,
	origin,
	availability,
	sizes = [],
	categories = [],
} = Astro.props;
---

<article class="product-card">
	<a href={href} class="product-link">
		{
			featuredImage ? (
				<div class="product-image">
					<Image image={featuredImage} />
				</div>
			) : (
				<div class="product-placeholder" aria-hidden="true" />
			)
		}

		<div class="product-body">
			<div class="product-meta">
				{categories[0] && <span>{categories[0].label}</span>}
				{categories[0] && <span class="meta-dot" />}
				<span>{origin}</span>
			</div>
			<h2 class="product-title">{title}</h2>
			{description && <p class="product-description">{description}</p>}
		</div>
	</a>

	<footer class="product-footer">
		<span class="availability">{availability}</span>
		{sizes.length > 0 && <span class="sizes">{sizes.slice(0, 2).join(" · ")}</span>}
	</footer>
</article>

<style>
	.product-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
	}

	.product-link {
		display: flex;
		flex: 1;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}

	.product-image,
	.product-placeholder {
		aspect-ratio: 4 / 3;
		margin-bottom: var(--spacing-4);
		overflow: hidden;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.product-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 0.3s ease;
	}

	.product-link:hover .product-image img {
		transform: scale(1.035);
	}

	.product-body {
		flex: 1;
	}

	.product-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.product-title {
		margin-bottom: var(--spacing-2);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		transition: color var(--transition-fast);
	}

	.product-link:hover .product-title {
		color: var(--color-brand);
	}

	.product-description {
		display: -webkit-box;
		overflow: hidden;
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.product-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		margin-top: var(--spacing-4);
		padding-top: var(--spacing-3);
		border-top: 1px solid var(--color-border-subtle);
		font-size: var(--font-size-xs);
	}

	.availability {
		color: var(--color-brand);
		font-weight: 500;
	}

	.sizes {
		overflow: hidden;
		color: var(--color-muted);
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
